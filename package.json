{
  "name": "minotaurx-miner-electron",
  "version": "1.0.0",
  "description": "Browser Electron personale per mining MinotaurX continuo",
  "main": "main.js",
  "scripts": {
    "start": "node node_modules/electron/cli.js .",
    "build": "electron-builder --win"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.minotaurx.miner",
    "productName": "Miner LTC",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}